  "description": "MeritLink: blockchain-backed verification of student extracurricular records (ALU summative)",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "hardhat": "^2.29.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
