{
  "name": "meritlink",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "interact:local": "hardhat run scripts/interact.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "interact:sepolia": "hardhat run scripts/interact.js --network sepolia",
    "verify:sepolia": "node scripts/verify-etherscan.js",
    "frontend": "node scripts/serve-frontend.js",
    "demo-record:local": "hardhat run scripts/issue-demo.js --network localhost",
    "demo-record:sepolia": "hardhat run scripts/issue-demo.js --network sepolia"
  },
