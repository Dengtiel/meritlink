# Copy this file to .env and fill in the values. NEVER commit .env.

# Sepolia RPC endpoint from Alchemy / Infura / any provider, e.g.
# https://eth-sepolia.g.alchemy.com/v2/<your-key>
SEPOLIA_RPC_URL=

# Private key of a TEST-ONLY wallet that holds Sepolia ETH (from a faucet).
# Never use a wallet that holds real funds.
PRIVATE_KEY=

# Etherscan API key (https://etherscan.io/myapikey) for source verification.
ETHERSCAN_API_KEY=

# Platform secret used to derive pseudonymous student references. Any random string.
STUDENT_REF_SALT=change-me-to-a-long-random-string

# Set to true to write a gas report when running tests.
REPORT_GAS=false
